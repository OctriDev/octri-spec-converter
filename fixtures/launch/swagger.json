  {
    "name": "reusable-response-and-schema-reference",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "produces": ["application/json"],
      "definitions": {
        "Pet": {
          "type": "object",
          "properties": { "id": { "type": "integer" } }
        }
      },
      "responses": {
        "Pet": {
          "description": "Pet",
          "schema": { "$ref": "#/definitions/Pet" }
        }
      },
      "paths": {
        "/pets": {
          "get": { "responses": { "200": { "$ref": "#/responses/Pet" } } }
        }
      }
    },
    "expected": {
      "/paths/~1pets/get/responses/200/$ref": "#/components/responses/Pet",
      "/components/responses/Pet/content/application~1json/schema/$ref": "#/components/schemas/Pet"
    }
  },
  {
    "name": "response-header-numeric-constraints",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "paths": {
        "/pets": {
          "get": {
            "responses": {
              "204": {
                "description": "Empty",
                "headers": {
                  "X-Remaining": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Calls left"
                  }
                }
              }
            }
          }
        }
      }
    },
    "expected": {
      "/paths/~1pets/get/responses/204/headers/X-Remaining/schema/type": "integer",
      "/paths/~1pets/get/responses/204/headers/X-Remaining/schema/minimum": 0,
      "/paths/~1pets/get/responses/204/headers/X-Remaining/description": "Calls left"
    }
  },
  {
    "name": "literal-example-reference-is-inert",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "produces": ["application/json"],
      "paths": {
        "/pets": {
          "get": {
            "tags": ["Pets"],
            "externalDocs": { "url": "https://docs.example.com/pets" },
            "x-team": "pets",
            "responses": {
              "200": {
                "description": "Pet",
                "schema": { "type": "object" },
                "examples": {
                  "application/json": { "$ref": "literal-data", "name": "猫" }
                }
              }
            }
          }
        }
      }
    },
    "expected": {
      "/paths/~1pets/get/responses/200/content/application~1json/example": {
        "$ref": "literal-data",
        "name": "猫"
      },
      "/paths/~1pets/get/x-team": "pets",
      "/paths/~1pets/get/tags": ["Pets"],
      "/paths/~1pets/get/externalDocs/url": "https://docs.example.com/pets"
    }
  },
  {
    "name": "path-parameter-inheritance-and-operation-override",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "paths": {
        "/pets/{id}": {
          "parameters": [
            { "name": "id", "in": "path", "type": "string", "required": true },
            {
              "name": "limit",
              "in": "query",
              "type": "integer",
              "maximum": 100
            }
          ],
          "get": {
            "parameters": [
              {
                "name": "limit",
                "in": "query",
                "type": "integer",
                "maximum": 10
              }
            ],
            "responses": { "204": { "description": "Empty" } }
          }
        }
      }
    },
    "expected": {
      "/paths/~1pets~1{id}/get/parameters/0/name": "id",
      "/paths/~1pets~1{id}/get/parameters/0/required": true,
      "/paths/~1pets~1{id}/get/parameters/1/name": "limit",
      "/paths/~1pets~1{id}/get/parameters/1/schema/maximum": 10
    }
  }
]
