  {
    "name": "oauth-authorization-code-scopes",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "securityDefinitions": {
        "oauth": {
          "type": "oauth2",
          "flow": "accessCode",
          "authorizationUrl": "https://auth.example.com/authorize",
          "tokenUrl": "https://auth.example.com/token",
          "scopes": { "pets:read": "Read pets" }
        }
      },
      "security": [{ "oauth": ["pets:read"] }],
      "paths": {}
    },
    "expected": {
      "/components/securitySchemes/oauth/flows/authorizationCode/authorizationUrl": "https://auth.example.com/authorize",
      "/components/securitySchemes/oauth/flows/authorizationCode/tokenUrl": "https://auth.example.com/token",
      "/components/securitySchemes/oauth/flows/authorizationCode/scopes": {
        "pets:read": "Read pets"
      },
      "/security": [{ "oauth": ["pets:read"] }]
    }
  },
  {
    "name": "security-and-or-and-anonymous-alternative",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "securityDefinitions": {
        "key": { "type": "apiKey", "name": "X-Key", "in": "header" },
