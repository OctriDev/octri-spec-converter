  },
  {
    "name": "multipart-binary-file",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "consumes": ["multipart/form-data"],
      "paths": {
        "/photos": {
          "post": {
            "parameters": [
              {
                "name": "photo",
                "in": "formData",
                "type": "file",
                "required": true
              }
            ],
            "responses": { "201": { "description": "Uploaded" } }
          }
        }
      }
    },
    "expected": {
      "/paths/~1photos/post/requestBody/required": true,
      "/paths/~1photos/post/requestBody/content/multipart~1form-data/schema/properties/photo/type": "string",
      "/paths/~1photos/post/requestBody/content/multipart~1form-data/schema/properties/photo/format": "binary",
      "/paths/~1photos/post/requestBody/content/multipart~1form-data/schema/required": [
        "photo"
      ]
    }
  },
  {
    "name": "urlencoded-form-constraints",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
