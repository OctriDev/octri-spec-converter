[
  {
    "name": "https-server-with-base-path",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "basePath": "/v1",
      "schemes": ["https"],
      "paths": {
        "/pets": {
          "get": { "responses": { "204": { "description": "Empty" } } }
        }
      }
    },
    "expected": {
      "/servers/0/url": "https://api.example.com/v1",
      "/paths/~1pets/get/responses/204/description": "Empty"
    }
  },
  {
    "name": "multiple-declared-server-schemes",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https", "http"],
      "paths": {}
    },
    "expected": {
      "/servers/0/url": "https://api.example.com/",
      "/servers/1/url": "http://api.example.com/"
    }
  },
  {
    "name": "required-json-body-reference",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "consumes": ["application/json"],
      "definitions": {
        "Pet": {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string" } }
        }
      },
      "paths": {
        "/pets": {
          "post": {
            "parameters": [
              {
                "name": "pet",
                "in": "body",
                "required": true,
                "schema": { "$ref": "#/definitions/Pet" }
              }
            ],
            "responses": { "201": { "description": "Created" } }
          }
        }
      }
    },
    "expected": {
      "/paths/~1pets/post/requestBody/required": true,
      "/paths/~1pets/post/requestBody/content/application~1json/schema/$ref": "#/components/schemas/Pet",
      "/components/schemas/Pet/required": ["name"]
    }
  },
  {
    "name": "nullable-string-property",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "definitions": {
        "Pet": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "x-nullable": true, "minLength": 1 }
          }
        }
      },
      "paths": {}
    },
    "expected": {
      "/components/schemas/Pet/properties/name/type": ["string", "null"],
      "/components/schemas/Pet/properties/name/minLength": 1
    },
    "absent": ["/components/schemas/Pet/properties/name/x-nullable"]
  },
  {
    "name": "exclusive-numeric-bounds",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "definitions": {
        "Rating": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "maximum": 5,
          "exclusiveMaximum": false,
          "multipleOf": 0.5
        }
      },
      "paths": {}
    },
    "expected": {
      "/components/schemas/Rating/exclusiveMinimum": 0,
      "/components/schemas/Rating/maximum": 5,
      "/components/schemas/Rating/multipleOf": 0.5
    },
    "absent": [
      "/components/schemas/Rating/minimum",
      "/components/schemas/Rating/exclusiveMaximum"
    ]
  },
  {
    "name": "repeated-query-array",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "paths": {
        "/pets": {
          "get": {
            "parameters": [
              {
                "name": "tag",
                "in": "query",
                "type": "array",
                "items": { "type": "string" },
                "collectionFormat": "multi"
              }
            ],
            "responses": { "204": { "description": "Empty" } }
          }
        }
      }
    },
    "expected": {
      "/paths/~1pets/get/parameters/0/name": "tag",
      "/paths/~1pets/get/parameters/0/style": "form",
      "/paths/~1pets/get/parameters/0/explode": true,
      "/paths/~1pets/get/parameters/0/schema/items/type": "string"
    }
  },
  {
    "name": "comma-separated-query-array",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
