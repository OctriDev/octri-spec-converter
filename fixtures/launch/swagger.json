  {
    "name": "basic-authentication",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "securityDefinitions": { "basic": { "type": "basic" } },
      "security": [{ "basic": [] }],
      "paths": {
        "/pets": {
          "get": { "responses": { "204": { "description": "Empty" } } }
        }
      }
    },
    "expected": {
      "/components/securitySchemes/basic": {
        "type": "http",
        "scheme": "basic"
      },
      "/security": [{ "basic": [] }]
    }
  },
  {
    "name": "header-api-key",
