  {
    "name": "operation-removes-inherited-authentication",
    "source": {
      "swagger": "2.0",
      "info": { "title": "Pets", "version": "1" },
      "host": "api.example.com",
      "schemes": ["https"],
      "securityDefinitions": { "basic": { "type": "basic" } },
      "security": [{ "basic": [] }],
      "paths": {
        "/health": {
          "get": {
            "security": [],
            "responses": { "204": { "description": "Healthy" } }
          }
        }
      }
    },
    "expected": {
      "/security": [{ "basic": [] }],
      "/paths/~1health/get/security": []
    }
