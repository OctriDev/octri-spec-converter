  {
    "name": "oauth-client-credentials-and-scope",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": {
        "type": "oauth2",
        "oauth2": [
          { "key": "grant_type", "value": "client_credentials" },
          {
            "key": "accessTokenUrl",
            "value": "https://auth.example.com/token"
          },
          { "key": "scope", "value": "pets:read pets:write" }
        ]
      },
      "item": [
        {
          "name": "List",
          "request": { "method": "GET", "url": "https://api.example.com/pets" }
        }
      ]
    },
    "expected": {
      "/paths/~1pets/get/summary": "List"
    },
    "expectedSingleAuth": {
      "/paths/~1pets/get": {
        "scheme": {
          "type": "oauth2",
          "flows": {
            "clientCredentials": {
              "tokenUrl": "https://auth.example.com/token",
              "scopes": { "pets:read": "", "pets:write": "" }
            }
          }
        },
        "scopes": ["pets:read", "pets:write"]
      }
    }
  },
  {
    "name": "json-example-does-not-invent-required-or-enum",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "https://api.example.com/pets",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"猫\",\"age\":2}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    "expected": {
      "/paths/~1pets/post/requestBody/content/application~1json/example": {
        "name": "猫",
        "age": 2
      },
      "/paths/~1pets/post/requestBody/content/application~1json/schema/properties/age/type": "integer"
    },
    "absent": [
      "/paths/~1pets/post/requestBody/content/application~1json/schema/required",
      "/paths/~1pets/post/requestBody/content/application~1json/schema/properties/name/enum"
    ]
  },
  {
    "name": "plain-text-body",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "https://api.example.com/notes",
            "body": {
              "mode": "raw",
              "raw": "Hello 猫",
              "options": { "raw": { "language": "text" } }
            }
          }
        }
      ]
