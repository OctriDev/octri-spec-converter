[
  {
    "name": "get-request-name-and-url",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List pets",
          "request": { "method": "GET", "url": "https://api.example.com/pets" }
        }
      ]
    },
    "expected": {
      "/paths/~1pets/get/summary": "List pets",
      "/paths/~1pets/get/servers/0/url": "https://api.example.com",
      "/paths/~1pets/get/security": []
    }
  },
  {
    "name": "patch-method-and-description",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Update pet",
          "request": {
            "method": "PATCH",
            "description": "Update selected fields.",
            "url": "https://api.example.com/pets/one"
          }
        }
      ]
    },
    "expected": {
      "/paths/~1pets~1one/patch/summary": "Update pet",
      "/paths/~1pets~1one/patch/description": "Update selected fields."
    },
    "absent": ["/paths/~1pets~1one/post"]
  },
  {
    "name": "nested-folders-become-ordered-tags",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Animals",
          "item": [
            {
              "name": "Pets",
              "item": [
                {
                  "name": "List",
                  "request": {
                    "method": "GET",
                    "url": "https://api.example.com/pets"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "expected": { "/paths/~1pets/get/tags": ["Animals", "Pets"] }
  },
  {
    "name": "collection-variable-url",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "variable": [{ "key": "base", "value": "https://api.example.com" }],
      "item": [
        {
          "name": "List",
          "request": { "method": "GET", "url": "{{base}}/pets" }
        }
      ]
    },
    "expected": { "/paths/~1pets/get/servers/0/url": "https://api.example.com" }
  },
  {
    "name": "supplied-environment-overrides-collection",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "variable": [
        { "key": "base", "value": "https://collection.example.com" }
      ],
      "item": [
        {
          "name": "List",
          "request": { "method": "GET", "url": "{{base}}/pets" }
        }
      ]
    },
    "files": {
      "environment.json": "{\"values\":[{\"key\":\"base\",\"value\":\"https://environment.example.com\",\"enabled\":true}]}"
    },
    "config": { "environmentUri": "environment.json" },
    "expected": {
      "/paths/~1pets/get/servers/0/url": "https://environment.example.com"
    }
  },
  {
    "name": "folder-variable-is-local-to-children",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "variable": [
        { "key": "base", "value": "https://collection.example.com" }
      ],
      "item": [
        {
          "name": "Folder",
          "variable": [
            { "key": "base", "value": "https://folder.example.com" }
          ],
          "item": [
            {
              "name": "List",
              "request": { "method": "GET", "url": "{{base}}/pets" }
            }
          ]
        },
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{base}}/health" }
        }
      ]
    },
    "expected": {
      "/paths/~1pets/get/servers/0/url": "https://folder.example.com",
      "/paths/~1health/get/servers/0/url": "https://collection.example.com"
    }
  },
  {
    "name": "explicit-variable-overrides-environment-and-folder",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Folder",
          "variable": [
            { "key": "base", "value": "https://folder.example.com" }
          ],
          "item": [
            {
              "name": "List",
              "request": { "method": "GET", "url": "{{base}}/pets" }
            }
          ]
        }
      ]
    },
    "files": {
      "environment.json": "{\"values\":[{\"key\":\"base\",\"value\":\"https://environment.example.com\"}]}"
    },
    "config": {
      "environmentUri": "environment.json",
      "variables": { "base": "https://configured.example.com" }
    },
    "expected": {
      "/paths/~1pets/get/servers/0/url": "https://configured.example.com"
    }
  },
  {
