    "expected": {
      "/paths/~1notes/post/requestBody/content/text~1plain/example": "Hello 猫",
      "/paths/~1notes/post/requestBody/content/text~1plain/schema/type": "string"
    }
  },
  {
    "name": "urlencoded-active-fields-only",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "https://api.example.com/pets",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Ada" },
                { "key": "secret", "value": "disabled", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    "expected": {
      "/paths/~1pets/post/requestBody/content/application~1x-www-form-urlencoded/schema/properties/name/type": "string"
    },
    "absent": [
      "/paths/~1pets/post/requestBody/content/application~1x-www-form-urlencoded/schema/properties/secret"
    ]
  },
  {
    "name": "multipart-file-is-described-never-read",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Upload",
          "request": {
            "method": "POST",
            "url": "https://api.example.com/photos",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": "/must-not-read/private.jpg"
                },
                { "key": "title", "type": "text", "value": "Portrait" }
              ]
            }
          }
        }
      ]
    },
    "expected": {
      "/paths/~1photos/post/requestBody/content/multipart~1form-data/schema/properties/photo/type": "string",
      "/paths/~1photos/post/requestBody/content/multipart~1form-data/schema/properties/photo/format": "binary",
      "/paths/~1photos/post/requestBody/content/multipart~1form-data/schema/properties/title/type": "string"
    },
    "decisionCodes": ["FILE_CONTENT_NOT_READ"]
  },
  {
    "name": "observed-response-status-and-json-example",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "https://api.example.com/pets"
          },
          "response": [
            {
              "name": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\"id\":7,\"name\":\"Ada\"}"
            }
          ]
        }
      ]
    },
    "expected": {
      "/paths/~1pets/post/responses/201/content/application~1json/example": {
        "id": 7,
        "name": "Ada"
      },
      "/paths/~1pets/post/responses/201/content/application~1json/schema/properties/id/type": "integer"
    }
  },
  {
    "name": "structured-path-query-and-disabled-header",
    "source": {
      "info": {
        "name": "Pets",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Read",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://api.example.com/pets/:id?ignored=1",
              "variable": [{ "key": "id", "value": "one" }],
              "query": [{ "key": "ignored", "value": "1", "disabled": true }]
            },
            "header": [
              { "key": "X-Region", "value": "eu" },
              { "key": "X-Ignored", "value": "off", "disabled": true }
            ]
          }
        }
      ]
    },
    "expected": {
      "/paths/~1pets~1{id}/get/parameters/0/name": "id",
      "/paths/~1pets~1{id}/get/parameters/0/in": "path",
      "/paths/~1pets~1{id}/get/parameters/0/required": true,
      "/paths/~1pets~1{id}/get/parameters/1/name": "X-Region",
      "/paths/~1pets~1{id}/get/parameters/1/in": "header"
    },
    "absent": ["/paths/~1pets~1{id}/get/parameters/2"]
  }
]
